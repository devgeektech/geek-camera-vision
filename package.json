{
  "name": "visionops",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter @visionops/api --filter @visionops/worker --filter @visionops/web dev",
    "build": "pnpm -r --filter @visionops/api --filter @visionops/worker --filter @visionops/web build",
    "test": "pnpm --filter @visionops/shared test",
    "db:generate": "pnpm --filter @visionops/db generate",
    "db:migrate": "pnpm --filter @visionops/db migrate",
    "typecheck": "pnpm -r --filter @visionops/shared --filter @visionops/db --filter @visionops/api --filter @visionops/worker --filter @visionops/web exec tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "onnxruntime-node",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "typescript-eslint": "^8.28.0"
  }
}
